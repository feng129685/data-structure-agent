# Node compatibility service. Copy to .env only for local development.
# Production uses /etc/structify/structify.env; never commit that file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8791
CORS_ALLOWED_ORIGINS=https://structify.cn,https://admin.structify.cn

# Generate with: openssl rand -hex 32
# Node signs its legacy frontend Bearer tokens with this key. It must differ
# from Spring's JWT_SECRET, which is not supplied to the Node production container.
NODE_COMPAT_JWT_SECRET=__GENERATE_AT_LEAST_64_RANDOM_CHARACTERS__
STRUCTIFY_PRIVATE_ROOT=private
NODE_STATE_DIR=private/state/node
DB_PATH=private/state/node/data.db

# Private course paths. Keep them outside the public source tree in production.
KNOWLEDGE_DIR=private/knowledge
PRESENTATION_DIR=private/presentation-materials
PDF_DIR=private/pdfs
PRESENTATION_ASSET_URL_TTL_SECONDS=900
KNOWLEDGE_SEARCH_LIMIT=4
KNOWLEDGE_CONTEXT_MAX_CHARS=3600
KNOWLEDGE_MIN_SCORE=8
KNOWLEDGE_DEBUG_API=false

# Do not capture verification codes or grant roles from static email lists.
VERIFICATION_CODE_FILE=
TEACHER_EMAILS=
ALLOW_FIRST_USER_TEACHER=false
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=30
CODE_REQUEST_RATE_WINDOW_MS=600000
CODE_REQUEST_RATE_MAX=3
CODE_REQUEST_IP_RATE_MAX=12
CODE_MAX_ATTEMPTS=5
CODE_LOCK_MS=900000

# OpenAI-compatible model. Leave every field empty until an administrator has
# selected a provider, its documented Base URL, and an exact Model ID.
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_TIMEOUT_MS=45000
MODEL_STREAM_IDLE_TIMEOUT_MS=30000

# SMTP. Use port 465 for implicit TLS or 587 for STARTTLS.
SMTP_HOST=smtp.example.invalid
SMTP_CONNECT_HOST=smtp.example.invalid
SMTP_TLS_SERVERNAME=smtp.example.invalid
SMTP_PORT=465
SMTP_USER=__SET_IN_SECRET_STORE__
SMTP_PASS=__SET_IN_SECRET_STORE__
SMTP_FROM=no-reply@structify.cn

# Remote sandboxes only. Never execute user code on the web host.
JUDGE0_BASE_URL=https://judge0.example.invalid
PISTON_BASE_URL=https://piston.example.invalid/api/v2/piston
EXECUTE_RATE_WINDOW_MS=60000
EXECUTE_RATE_MAX=8
EXECUTE_MAX_CONCURRENCY=4
EXECUTE_PER_IP_CONCURRENCY=2
EXECUTE_TIMEOUT_MS=15000
EXECUTE_PROVIDER_TIMEOUT_MS=8000
EXECUTE_OUTPUT_MAX_CHARS=6000
EXECUTE_ERROR_MAX_CHARS=4000

# Upload limits in bytes.
PDF_UPLOAD_MAX_BYTES=26214400
PDF_FILE_MAX_BYTES=20971520
PDF_UPLOAD_MAX_FILES=5
UPLOAD_REQUEST_MAX_BYTES=22020096
