HOST=127.0.0.1
PORT=8791

# AI Model
MODEL_PROVIDER=deepseek
MODEL_API_KEY=your_api_key_here
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-pro
MODEL_TIMEOUT_MS=45000
MODEL_STREAM_IDLE_TIMEOUT_MS=30000

# Private course knowledge (optional)
# Default: knowledge/private/textbook
KNOWLEDGE_DIR=knowledge/private/textbook
KNOWLEDGE_SEARCH_LIMIT=4
KNOWLEDGE_CONTEXT_MAX_CHARS=3600
KNOWLEDGE_MIN_SCORE=8
# Enable only for local/team inspection; it exposes short OCR excerpts.
KNOWLEDGE_DEBUG_API=false

# Authentication and abuse protection
# Leave empty in local development to use the generated .jwt-secret file.
JWT_SECRET=
TEACHER_EMAILS=teacher@example.com
ALLOW_FIRST_USER_TEACHER=false
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=30
CODE_REQUEST_RATE_WINDOW_MS=600000
CODE_REQUEST_RATE_MAX=3
CODE_REQUEST_IP_RATE_MAX=12
CODE_MAX_ATTEMPTS=5
EXECUTE_PROVIDER_TIMEOUT_MS=8000

# Upload limits
PDF_UPLOAD_MAX_BYTES=26214400
PDF_FILE_MAX_BYTES=20971520
PDF_UPLOAD_MAX_FILES=5
UPLOAD_REQUEST_MAX_BYTES=22020096

# SMTP (optional, for email notifications)
SMTP_HOST=smtp.example.com
SMTP_CONNECT_HOST=smtp.example.com
SMTP_TLS_SERVERNAME=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
