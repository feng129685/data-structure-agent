# Copy outside the repository to /etc/structify/structify.env and chmod 600.
# Every __...__ value is intentionally invalid until an operator replaces it.
COMPOSE_PROJECT_NAME=structify
# Required only when CADDY_MODE=container and ORIGIN_CERT_DIR_HOST is empty.
# In host mode, the existing host Caddy installation owns certificate storage.
ACME_EMAIL=
# Optional only for CADDY_MODE=container. When set, this absolute host
# directory must contain operator-managed Origin CA files named origin.crt and
# origin.key. The files stay outside the repository and are mounted read-only.
# Leave empty to preserve the existing ACME behavior (and require ACME_EMAIL).
ORIGIN_CERT_DIR_HOST=
# The preflight certificate check runs this exact image with network disabled.
# Keep it aligned with the Compose Caddy image and use an immutable mirror only
# after separately recording its digest.
CADDY_IMAGE=caddy:2.10-alpine

# `host` keeps the existing host Caddy in control of public 80/443 and uses
# the append-only Caddyfile.host.production site block. Set `container` only
# on a host where Structify exclusively owns those public ports.
CADDY_MODE=host
# Container mode only. This stable host directory is mounted at /etc/caddy and
# is deliberately outside each versioned release directory. deploy.sh atomically
# synchronizes Caddyfile.production here before reloading the running container.
CADDY_CONFIG_DIR_HOST=/srv/structify/caddy
# Required in host mode only. This is the complete existing Caddyfile that
# imports Caddyfile.host.production; preflight validates it without reloading.
HOST_CADDY_CONFIG=/etc/caddy/Caddyfile
# The default low-memory profile has 1,088 MiB of hard service limits:
# MySQL 384 + Node 256 + Spring 384 + optional Caddy 64. The reservation
# evidence is 768 MiB plus a 256 MiB host reserve, while the full hard-cap
# envelope is 1,344 MiB. A host with about 1.4 GiB MemAvailable may pass only
# while these declared values still fit the gate.
MEMORY_PROFILE=low-memory
MEMORY_BUDGET_MB=1024
MEMORY_RESERVE_MB=256
MIN_AVAILABLE_MEMORY_MB=1024
MYSQL_MEMORY_LIMIT=384m
MYSQL_MEMORY_RESERVATION=256m
NODE_MEMORY_LIMIT=256m
NODE_MEMORY_RESERVATION=160m
NODE_MAX_OLD_SPACE_MB=160
SPRING_MEMORY_LIMIT=384m
SPRING_MEMORY_RESERVATION=288m
CADDY_MEMORY_LIMIT=64m
CADDY_MEMORY_RESERVATION=64m
NODE_HOST_PORT=18791
SPRING_HOST_PORT=18792

# Official images are the default. Set only when Docker Hub is unavailable
# and the release operator has verified a compatible mirror digest.
NODE_BASE_IMAGE=node:22-bookworm-slim
JAVA_BUILD_IMAGE=eclipse-temurin:21-jdk
JAVA_RUNTIME_IMAGE=eclipse-temurin:21-jre

# Immutable release tags are required for verifiable rollback.
NODE_IMAGE=structify-node:__RELEASE_ID__
SPRING_IMAGE=structify-spring:__RELEASE_ID__

MYSQL_DATABASE=structify
MYSQL_USER=__SET_DB_USER__
MYSQL_PASSWORD=__SET_IN_SECRET_STORE__
MYSQL_ROOT_PASSWORD=__SET_IN_SECRET_STORE__
# Direct-host Spring only; production Compose derives this from MYSQL_DATABASE.
DB_URL=jdbc:mysql://mysql:3306/structify?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true&requireSSL=true

# Standard Spring session-token signing key. Node never receives this key.
JWT_SECRET=__GENERATE_AT_LEAST_64_RANDOM_CHARACTERS__
# Dedicated migration key for tokens issued by the legacy Node login. Keep it
# distinct from JWT_SECRET. Spring accepts these tokens only on the documented
# learning/animation evidence endpoints while NODE_COMPAT_ENABLED is true.
NODE_COMPAT_ENABLED=true
NODE_COMPAT_JWT_SECRET=__GENERATE_A_DIFFERENT_AT_LEAST_64_RANDOM_CHARACTERS__
CORS_ALLOWED_ORIGINS=https://structify.cn,https://admin.structify.cn
AUTH_TOKEN_ISSUER=structify.cn
AUTH_TOKEN_TTL=PT2H
AUTH_COOKIE_NAME=ds_session
AUTH_COOKIE_SECURE=true
AUTH_EXPOSE_DEV_CODE=false
# Set true only after all SMTP fields are configured and delivery is verified.
AUTH_MAIL_ENABLED=false

# Static administrator/teacher email elevation is disabled in production.
BOOTSTRAP_ADMIN_EMAIL=
TEACHER_EMAILS=
ALLOW_FIRST_USER_TEACHER=false

# Optional at startup. Leave all fields empty until an administrator provides
# the provider, documented Base URL, and exact Model ID.
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_TIMEOUT=PT45S
MODEL_STREAM_IDLE_TIMEOUT=PT30S
MODEL_TIMEOUT_MS=45000
MODEL_STREAM_IDLE_TIMEOUT_MS=30000
MODEL_MAX_RESPONSE_BYTES=1048576

SMTP_HOST=
SMTP_CONNECT_HOST=
SMTP_TLS_SERVERNAME=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@structify.cn
SMTP_AUTH=true
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL_CHECK_SERVER_IDENTITY=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000

# Host paths are mounted read-only into application containers.
PRIVATE_ROOT=/srv/structify/private
KNOWLEDGE_DIR_HOST=/srv/structify/private/knowledge
RESOURCE_DIR_HOST=/srv/structify/private/course-content
PRESENTATION_DIR_HOST=/srv/structify/private/presentation-materials
# Read-only release source for the Node course-PDF seed. It imports once with
# a dedicated marker and never overwrites the persistent node-pdfs upload volume.
PDF_SOURCE_DIR_HOST=/srv/structify/private/pdfs

# Team-controlled remote sandboxes. These are service URLs, not credentials.
# Optional at startup. Leave both empty to disable remote code execution.
JUDGE0_BASE_URL=
PISTON_BASE_URL=
EXECUTE_TIMEOUT=PT15S
EXECUTE_TIMEOUT_MS=15000
EXECUTE_PROVIDER_TIMEOUT_MS=8000
EXECUTE_CODE_MAX_LENGTH=20000
EXECUTE_INPUT_MAX_LENGTH=12000
EXECUTE_OUTPUT_MAX_LENGTH=6000
EXECUTE_MAX_CONCURRENT=4
EXECUTE_MAX_CONCURRENT_PER_CLIENT=1
EXECUTE_RATE_WINDOW_MS=60000
EXECUTE_RATE_MAX=8
EXECUTE_PER_IP_CONCURRENCY=2
EXECUTE_COMPILE_TIMEOUT_MS=10000
EXECUTE_RUN_TIMEOUT_MS=3000

# Node compatibility data and safety settings.
PRESENTATION_ASSET_URL_TTL_SECONDS=900
KNOWLEDGE_SEARCH_LIMIT=4
KNOWLEDGE_CONTEXT_MAX_CHARS=3600
KNOWLEDGE_MIN_SCORE=8
KNOWLEDGE_DEBUG_API=false
VERIFICATION_CODE_FILE=
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=30
CODE_REQUEST_RATE_WINDOW_MS=600000
CODE_REQUEST_RATE_MAX=3
CODE_REQUEST_IP_RATE_MAX=12
CODE_MAX_ATTEMPTS=5
CODE_LOCK_MS=900000
PDF_UPLOAD_MAX_BYTES=26214400
PDF_FILE_MAX_BYTES=20971520
PDF_UPLOAD_MAX_FILES=5
UPLOAD_REQUEST_MAX_BYTES=22020096
