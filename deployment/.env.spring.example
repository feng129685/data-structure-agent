MYSQL_DATABASE=ds_agent
MYSQL_USER=ds_agent
MYSQL_PASSWORD=replace_with_database_password
MYSQL_ROOT_PASSWORD=replace_with_root_password

JWT_SECRET=replace_with_at_least_32_random_characters
CORS_ALLOWED_ORIGINS=https://agent.example.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TEACHER_EMAILS=teacher@example.com

MODEL_PROVIDER=deepseek
MODEL_API_KEY=replace_with_model_api_key
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-pro
MODEL_MAX_RESPONSE_BYTES=1048576

# Only for a direct Spring Boot deployment. Docker Compose mounts private paths inside the container.
KNOWLEDGE_DIR=/absolute/path/to/private/textbook
KNOWLEDGE_AUTO_PUBLISH_LOCAL=false
RESOURCE_DIR=/absolute/path/to/private/course-content

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=no-reply@example.com
SMTP_AUTH=true
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL_CHECK_SERVER_IDENTITY=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000
AUTH_MAIL_ENABLED=true

# Prefer a team-controlled Piston deployment in production.
PISTON_BASE_URL=https://emkc.org/api/v2/piston
EXECUTE_TIMEOUT=PT15S
EXECUTE_CODE_MAX_LENGTH=20000
EXECUTE_INPUT_MAX_LENGTH=12000
EXECUTE_OUTPUT_MAX_LENGTH=6000
EXECUTE_MAX_CONCURRENT=4
EXECUTE_MAX_CONCURRENT_PER_CLIENT=1
EXECUTE_COMPILE_TIMEOUT_MS=10000
EXECUTE_RUN_TIMEOUT_MS=3000
