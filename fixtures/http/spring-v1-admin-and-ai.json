      "method": "POST",
      "path": "/chat",
      "request": {
        "prompt": "Explain stack ordering.",
        "chapterId": "03-stack-queue",
        "history": []
      },
      "response": {
        "code": "AI_QUOTA_NOT_CONFIGURED",
        "message": "Formal generation is unavailable until an enabled model and daily token quota are configured",
        "requestId": "req-chat-fixture"
